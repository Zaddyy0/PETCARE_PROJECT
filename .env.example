# ==========================================================================
#  Pawsitive — environment configuration
#
#  Copy to `.env` and fill in. The API validates every value at boot and
#  refuses to start with a precise message rather than failing later.
#
#  Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ==========================================================================

# ---------------------------------------------------------------- runtime --
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Comma-separated. Must list every origin the browser app is served from.
# Credentials are enabled, so `*` is not permitted here.
CORS_ORIGINS=http://localhost:5173

# Used to build links in outgoing email.
WEB_APP_URL=http://localhost:5173

# Number of reverse proxies in front of this process — NOT `true`.
#   0  local development
#   1  Render, Railway, Fly, a single nginx
# Trusting the whole X-Forwarded-For chain lets callers spoof their IP and
# walk straight through per-IP rate limiting.
TRUST_PROXY_HOPS=0

# --------------------------------------------------------------- database --
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pawsitive

# Per-instance connection pool ceiling. Atlas shared tiers cap total
# connections low, so leave headroom to run more than one instance.
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# ------------------------------------------------------------------- auth --
# REQUIRED in production, minimum 32 characters. In development these are
# generated per process if omitted — which means every restart signs everyone
# out, so set them to keep your session across reloads.
#
# Two separate secrets on purpose: sharing one would let a leaked access-token
# signature be replayed as a refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=pawsitive.api
JWT_AUDIENCE=pawsitive.web

# Hashes password-reset and invite tokens at rest, so a database dump does not
# yield working reset links.
TOKEN_PEPPER=

# Leave COOKIE_DOMAIN blank unless the API and web app are on sibling
# subdomains (e.g. api.example.com and app.example.com → .example.com).
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ------------------------------------------------------------- cloudinary --
# All three or none. Image uploads are rejected when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pawsitive

# ------------------------------------------------------------------- mail --
# With MAIL_ENABLED=false, emails are logged instead of sent — fine for
# development, but password resets and invitations cannot be delivered.
MAIL_ENABLED=false
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=resend
MAIL_PASSWORD=
MAIL_FROM=Pawsitive <no-reply@pawsitive.app>

# --------------------------------------------------------------- features --
ENABLE_REALTIME=true
ENABLE_SCHEDULED_JOBS=true
ENABLE_REQUEST_LOGGING=true

# ---------------------------------------------------------------- logging --
LOG_LEVEL=info
LOG_PRETTY=true

# --------------------------------------------------------- bootstrapping --
# When set, a super admin is created on first boot if none exists.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ----------------------------------------------------------- web client ---
# Consumed by Vite. Must be prefixed VITE_ to be exposed to the browser.
VITE_API_URL=http://localhost:5000/api/v1
